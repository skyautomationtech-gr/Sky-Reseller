rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin']
      );
    }

    function isApproved() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
      );
    }

    // Users collection rules
    match /users/{userId} {
      allow read, list: if isSignedIn();

      // Resellers can create their own document if role is reseller and status is pending
      allow create: if isSignedIn() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          request.resource.data.role in ['reseller', 'customer'] &&
          request.resource.data.status == 'pending' &&
          !request.resource.data.keys().hasAny([
            'rejectReason', 'suspensionType', 'approvedAt'
          ])
        )
      );

      // Resellers can only update their own document without altering restricted fields
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'status', 'resellerId', 'emailVerified', 'rejectReason', 'suspensionType', 'approvedAt'
          ])
        )
      );

      allow delete: if isSignedIn() && isAdmin();

      // Login History subcollection
      match /loginHistory/{historyId} {
        allow read, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }

    // Policy Pages collection rules (terms, privacy, rules, etc.)
    match /policyPages/{policyId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // Products collection rules (Read for all, Write for Admin)
    match /products/{productId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // Orders collection rules (Only approved users can create)
    match /orders/{orderId} {
      allow read, list: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isApproved();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Wallets, Transactions, WithdrawalRequests (Only approved)
    match /wallets/{walletId} {
      allow read, list: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow write: if isApproved() || isAdmin();
    }

    match /transactions/{transactionId} {
      allow read, list: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isApproved() || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /withdrawalRequests/{requestId} {
      allow read, list: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isApproved();
      allow update, delete: if isAdmin();
    }

    // Support Tickets (Only approved)
    match /supportTickets/{ticketId} {
      allow read, list: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isApproved();
      allow update, delete: if isAdmin();
    }

    // Product Reviews (Only approved)
    match /productReviews/{reviewId} {
      allow read, list: if true;
      allow create: if isApproved();
      allow update, delete: if isAdmin();
    }

    // Other collections (Admin only writes)
    match /categories/{categoryId} { allow read: if true; allow write: if isAdmin(); }
    match /brands/{brandId} { allow read: if true; allow write: if isAdmin(); }
    match /commissionSettings/{settingId} { allow read: if true; allow write: if isAdmin(); }
    match /counters/{counterId} { allow read: if true; allow write: if isAdmin(); }
    match /notices/{noticeId} { allow read: if true; allow write: if isAdmin(); }
    match /noticeReads/{readId} { allow read: if true; allow write: if isSignedIn(); }
    match /auditLogs/{logId} { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /userSessions/{sessionId} { allow read: if isAdmin(); allow write: if isSignedIn(); }
    match /settings/{settingId} { allow read: if true; allow write: if isAdmin(); }
    match /systemSettings/{settingId} { allow read: if true; allow write: if isAdmin(); }
    match /appVersion/{versionId} { allow read: if true; allow write: if isAdmin(); }
    match /payoutChangeRequests/{requestId} { allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin()); allow write: if isApproved() || isAdmin(); }
    match /feedback/{feedbackId} { allow read: if isAdmin(); allow write: if isSignedIn(); }
    match /changelogs/{changelogId} { allow read: if true; allow write: if isAdmin(); }

    match /liveChats/{chatId} {
      allow read, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isApproved() || isAdmin();

      match /messages/{messageId} {
        allow read, list: if isSignedIn() && (get(/databases/$(database)/documents/liveChats/$(chatId)).data.userId == request.auth.uid || isAdmin());
        allow write: if isApproved() || isAdmin();
      }
    }

    // Email OTPs collection - strictly server-side / Cloud Functions only
    match /emailOtps/{docId} {
      allow read, write: if false;
    }
  }
}


