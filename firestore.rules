rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdminEmail() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == 'skyautomationtech@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdminEmail() ||
        (request.auth.token.role in ['admin', 'super_admin']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'])
      );
    }

    function isApproved() {
      return isSignedIn() && (
        isSuperAdminEmail() ||
        (request.auth.token.role in ['admin', 'super_admin']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved')
      );
    }

    // Two-step OTP verified session check:
    // 1. Checks Firebase Auth Custom Claims (Production Cloud Function claims: otpSession & otpExpiresAt)
    // 2. OR checks verified adminSessions document (active 12-hour session)
    function isOtpVerified() {
      return isSignedIn() && (
        (request.auth.token.otpSession != null &&
         request.auth.token.otpExpiresAt != null &&
         request.time.toMillis() < request.auth.token.otpExpiresAt) ||
        (exists(/databases/$(database)/documents/adminSessions/$(request.auth.uid)) &&
         request.time.toMillis() < get(/databases/$(database)/documents/adminSessions/$(request.auth.uid)).data.expiresAt)
      );
    }

    // Super Admin requires BOTH the Super Admin identity AND an active OTP-verified session
    // (A Super Admin who signed in with password only has NO Super Admin powers until OTP is verified)
    function isSuperAdmin() {
      return isSignedIn() &&
        (
          isSuperAdminEmail() ||
          request.auth.token.role == 'super_admin' ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')
        ) &&
        isOtpVerified();
    }

    // Users collection rules
    match /users/{userId} {
      allow read, list: if isSignedIn();

      // Creating users: Resellers can self-register as pending; Admins can create resellers; Super Admin manages admins
      allow create: if isSignedIn() && (
        isSuperAdminEmail() ||
        (
          request.resource.data.role in ['admin', 'super_admin'] ? isSuperAdmin() : isAdmin()
        ) ||
        (
          request.auth.uid == userId &&
          request.resource.data.role in ['reseller', 'customer'] &&
          request.resource.data.status == 'pending' &&
          !request.resource.data.keys().hasAny([
            'rejectReason', 'suspensionType', 'approvedAt'
          ])
        )
      );

      // Updating users: Super Admin can update all; Admins can update resellers; Resellers can update basic profile
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (request.auth.uid == userId && isSuperAdminEmail()) ||
        (
          isAdmin() &&
          resource.data.role != 'admin' &&
          resource.data.role != 'super_admin' &&
          request.resource.data.role != 'admin' &&
          request.resource.data.role != 'super_admin'
        ) ||
        (
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'status', 'resellerId', 'emailVerified', 'rejectReason', 'suspensionType', 'approvedAt'
          ])
        )
      );

      // Deleting users is strictly restricted to verified Super Admin
      allow delete: if isSignedIn() && isSuperAdmin();

      // Login History subcollection
      match /loginHistory/{historyId} {
        allow read, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }

    // Policy Pages collection rules (terms, privacy, rules, etc.)
    match /policyPages/{policyId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // Products collection rules (Read for all, Write for Admin)
    match /products/{productId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // Orders collection rules (Only approved users can create)
    match /orders/{orderId} {
      allow read, list: if isSignedIn() && (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.resellerId || isAdmin());
      allow create: if isApproved();
      allow update: if isAdmin();
      // Deleting orders is strictly restricted to verified Super Admin
      allow delete: if isSuperAdmin();
    }

    // Wallets & Transactions
    match /wallets/{walletId} {
      allow read, list: if isSignedIn() && (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.resellerId || request.auth.uid == walletId || isAdmin());
      allow write: if isApproved() || isAdmin();
    }

    match /transactions/{transactionId} {
      allow read, list: if isSignedIn() && (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.resellerId || isAdmin());
      allow create: if isApproved() || isAdmin();
      allow update: if isAdmin();
      // Deleting transactions is strictly restricted to verified Super Admin
      allow delete: if isSuperAdmin();
    }

    // Withdrawal Requests: Approvals require Admin/SuperAdmin; Deleting requires Super Admin
    match /withdrawalRequests/{requestId} {
      allow read, list: if isSignedIn() && (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.resellerId || isAdmin());
      allow create: if isApproved();
      allow update: if isSuperAdmin() || isAdmin();
      allow delete: if isSuperAdmin();
    }

    // Commission Settings: Strictly Super Admin only
    match /commissionSettings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Company & System Settings: Strictly Super Admin only
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /systemSettings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Support Tickets (Only approved)
    match /supportTickets/{ticketId} {
      allow read, list: if isSignedIn() && (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.resellerId || isAdmin());
      allow create: if isApproved();
      allow update: if isSignedIn() && (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.resellerId || isAdmin());
      allow delete: if isAdmin();
    }

    // Product Reviews (Only approved)
    match /productReviews/{reviewId} {
      allow read, list: if true;
      allow create: if isApproved();
      allow update, delete: if isAdmin();
    }

    // Other collections (Admin writes)
    match /categories/{categoryId} { allow read: if true; allow write: if isAdmin(); }
    match /brands/{brandId} { allow read: if true; allow write: if isAdmin(); }
    match /counters/{counterId} { allow read: if true; allow write: if isAdmin(); }
    match /notices/{noticeId} { allow read: if true; allow write: if isAdmin(); }
    match /noticeReads/{readId} { allow read: if true; allow write: if isSignedIn(); }
    match /auditLogs/{logId} { allow read: if isAdmin(); allow write: if isSignedIn(); }
    match /userSessions/{sessionId} { allow read: if isAdmin(); allow write: if isSignedIn(); }
    match /appVersion/{versionId} { allow read: if true; allow write: if isAdmin(); }
    match /payoutChangeRequests/{requestId} { allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.resellerId || isAdmin()); allow write: if isApproved() || isAdmin(); }
    match /feedback/{feedbackId} { allow read: if isAdmin(); allow write: if isSignedIn(); }
    match /changelogs/{changelogId} { allow read: if true; allow write: if isAdmin(); }

    match /liveChats/{chatId} {
      allow read, list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.resellerId == request.auth.uid || isAdmin());
      allow write: if isApproved() || isAdmin();

      match /messages/{messageId} {
        allow read, list: if isSignedIn() && (get(/databases/$(database)/documents/liveChats/$(chatId)).data.userId == request.auth.uid || get(/databases/$(database)/documents/liveChats/$(chatId)).data.resellerId == request.auth.uid || isAdmin());
        allow write: if isApproved() || isAdmin();
      }
    }

    // Super Admin Active Verified Sessions (12-hour session tracking)
    match /adminSessions/{userId} {
      allow read, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Super Admin Login OTPs - strictly server-side / Cloud Functions only
    match /adminLoginOtps/{docId} {
      allow read, write: if false;
    }

    // Email OTPs collection - strictly server-side / Cloud Functions only
    match /emailOtps/{docId} {
      allow read, write: if false;
    }

    // Unique Shop Name Reservations - strictly server-side / Cloud Functions only
    match /shopNames/{shopNameKey} {
      allow read, write: if false;
    }
  }
}
