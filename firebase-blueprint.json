{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile entity",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string", "maxLength": 100 },
        "shopName": { "type": "string", "maxLength": 100 },
        "shopNameKey": { "type": "string", "maxLength": 100 },
        "mobile": { "type": "string", "maxLength": 20 },
        "email": { "type": "string", "maxLength": 100 },
        "division": { "type": "string" },
        "district": { "type": "string" },
        "upazila": { "type": "string" },
        "address": { "type": "string", "maxLength": 300 },
        "profilePhotoUrl": { "type": "string" },
        "shopPhotoUrl": { "type": "string" },
        "nidUrl": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "admin", "reseller"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "suspended"] },
        "rejectReason": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["uid", "fullName", "shopName", "mobile", "email", "role", "status"]
    },
    "ShopNameReservation": {
      "title": "ShopNameReservation",
      "description": "Unique shop name reservation entity",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "shopName": { "type": "string" },
        "shopNameKey": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["uid", "shopName", "shopNameKey", "createdAt"]
    },
    "PhoneChangeRequest": {
      "title": "PhoneChangeRequest",
      "description": "Phone number change request submitted by reseller for admin review",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "resellerName": { "type": "string" },
        "resellerId": { "type": "string" },
        "oldPhone": { "type": "string" },
        "newPhone": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["userId", "oldPhone", "newPhone", "reason", "status"]
    },
    "DeactivationRequest": {
      "title": "DeactivationRequest",
      "description": "Account deactivation request submitted by reseller for admin review",
      "type": "object",
      "properties": {
        "resellerId": { "type": "string" },
        "resellerName": { "type": "string" },
        "shopName": { "type": "string" },
        "mobile": { "type": "string" },
        "reason": { "type": "string" },
        "note": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "cancelled"] },
        "adminNote": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["resellerId", "reason", "status"]
    },
    "DeletionRequest": {
      "title": "DeletionRequest",
      "description": "Account permanent deletion request submitted by reseller for admin review",
      "type": "object",
      "properties": {
        "resellerId": { "type": "string" },
        "resellerName": { "type": "string" },
        "shopName": { "type": "string" },
        "mobile": { "type": "string" },
        "walletBalance": { "type": "number" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "cancelled"] },
        "adminNote": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["resellerId", "reason", "status"]
    },
    "EmailOtp": {
      "title": "EmailOtp",
      "description": "Server-only hashed email OTP verification record",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "type": { "type": "string", "enum": ["reseller_registration", "super_admin_login"] },
        "uid": { "type": "string" },
        "hashedCode": { "type": "string" },
        "expiresAt": { "type": "timestamp" },
        "attemptsLeft": { "type": "number" },
        "lastSentAt": { "type": "timestamp" },
        "lockedUntil": { "type": "timestamp" }
      },
      "required": ["email", "type", "hashedCode", "expiresAt", "attemptsLeft", "lastSentAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles collection"
    },
    "/shopNames/{shopNameKey}": {
      "schema": "ShopNameReservation",
      "description": "Unique shop name reservations collection, Cloud Functions / server only"
    },
    "/emailOtps/{docId}": {
      "schema": "EmailOtp",
      "description": "Hashed email OTP records, Cloud Functions only (clients denied)"
    },
    "/phone_change_requests/{requestId}": {
      "schema": "PhoneChangeRequest",
      "description": "Phone number change approval requests"
    },
    "/deactivationRequests/{requestId}": {
      "schema": "DeactivationRequest",
      "description": "Account deactivation requests"
    },
    "/deletionRequests/{requestId}": {
      "schema": "DeletionRequest",
      "description": "Account permanent deletion requests"
    }
  }
}
